{
  "$defs": {
    "Node": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "format": "uuid",
          "title": "Node Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "heading",
            "paragraph",
            "table",
            "image"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "source_location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "cells": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Cells",
          "type": "array"
        },
        "rows": {
          "default": 0,
          "title": "Rows",
          "type": "integer"
        },
        "cols": {
          "default": 0,
          "title": "Cols",
          "type": "integer"
        },
        "header": {
          "default": false,
          "title": "Header",
          "type": "boolean"
        },
        "merges": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Merges",
          "type": "array"
        },
        "image_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Key"
        },
        "image_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Sha256"
        }
      },
      "required": [
        "type",
        "source_location"
      ],
      "title": "Node",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "heading": {
          "title": "Heading",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "heading",
        "nodes"
      ],
      "title": "Section",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "default": "",
          "title": "Section",
          "type": "string"
        },
        "paragraph": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "table": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        }
      },
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    },
    "parser_version": {
      "title": "Parser Version",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "sections",
    "parser_version"
  ],
  "title": "NormalizedDocument",
  "type": "object"
}
# Bootstrap creates random local secrets. Never use real NPS data here.
POSTGRES_PASSWORD=
JWT_SECRET=
ADAPTER_SECRET=
SEED_PASSWORD=
ENVIRONMENT=dev
SCAN_MODE=mock
LLM_MODE=mock
COMFY_MODE=mock
DEV_INSECURE_COOKIE=true
EDGE_PORT=8080
# TBD-NPS-NET-001: approved origins, inbound/egress/edge binding
# TBD-NPS-IAM-001: SSO provider and claims
# TBD-NPS-GPU-001: backend URLs, model hash and device allocation
# TBD-NPS-STO-001: volumes, encryption, retention
# TBD-NPS-SEC-001: malware signatures, certificates, SIEM
# TBD-NPS-OUT-001: official template/font/logo/video profile
# TBD-NPS-PERF-001: final resource limits and SLA
# TBD-NPS-REL-001: import and release approval policy

# Built-in bounded HWP 5.x text parser
HWP_ENABLED=true
